# SearXNG environment — copy to .env and edit:  cp .env.example .env
# NEVER commit .env (it is in .gitignore). Read the docs before using:
# https://docs.searxng.org/admin/installation-docker.html

# SearXNG version tag. "latest" is fine while learning; on a server you
# care about, pin a dated tag (e.g. 2026.3.25-541c6c3cb) so upgrades
# happen when you decide, not when the registry changes under you.
#SEARXNG_VERSION=latest

# Bind address and port. 127.0.0.1 = localhost only: a PRIVATE instance,
# the video's home-lab option — only this machine can use it. That is
# the safe default. To serve your LAN, set your LAN IP here instead,
# and put authentication in front of it before exposing it further.
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8080

# Secret key — REQUIRED, SearXNG will not start without it.
# Generate once with:  openssl rand -hex 32
# then paste the output below. Never reuse the example, never share it,
# never commit it. (In the video this same value was written into
# settings.yml by a command; today it lives here as $SEARXNG_SECRET,
# which the container maps to server.secret_key.)
SEARXNG_SECRET=

# Domain + HTTPS (the video's .env step: SEARXNG_HOSTNAME and
# LETSENCRYPT_EMAIL for Caddy) no longer exist in the upstream template:
# the old searxng-docker stack bundled Caddy, the current one does not.
# For a public domain, run your own reverse proxy (Caddy or nginx) in
# front of http://localhost:8080 and set server.base_url in
# searxng/core-config/settings.yml to your https:// URL. See README.md.
