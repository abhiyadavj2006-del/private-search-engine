# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Generated search index files (the engine builds its index in memory,
# but any future on-disk index / cache belongs here, never in git)
index.json
index.pkl
*.idx
.cache/
*.sqlite3
*.db

# SearXNG (full version — see docker-compose.yml)
.env
# NOTE: searxng/core-config/settings.yml IS committed on purpose — it
# holds no secret. The only secret is SEARXNG_SECRET, which lives
# only in .env (never committed, never shared).

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
